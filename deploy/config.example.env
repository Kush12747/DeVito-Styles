# DeVito Styles - AWS deployment configuration
#
#   cp deploy/config.example.env deploy/config.env
#
# config.env is gitignored. Never commit real keys.
#
# This file is read by bash. If a value contains spaces, $, #, quotes or
# backslashes, wrap it in single quotes:  MAIL_PASSWORD='my$ecret pass'

# ---- AWS -----------------------------------------------------------------
AWS_REGION=us-east-1
# Named profile from ~/.aws/config. Leave blank to use your default credentials.
AWS_PROFILE=

# Prefix for resource names (lowercase, max 21 characters)
PROJECT_NAME=devito-styles
STACK_NAME=devito-styles

# ---- Sizing (defaults are the cheapest sensible options) ------------------
DB_INSTANCE_CLASS=db.t4g.micro
DB_ALLOCATED_STORAGE=20
TASK_CPU=512
TASK_MEMORY=1024

# ---- App secrets (stored in AWS Secrets Manager by 1-setup.sh) -----------
# Email (SMTP). For Gmail, use an app password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=

# Stripe. Use test keys (sk_test_...) until you're ready for real payments.
STRIPE_SECRET_KEY=
# Leave blank for the first deploy. After the site is up, create a webhook
# endpoint in the Stripe dashboard (see deploy/README.md), paste its
# signing secret here, then run: ./deploy/scripts/update.sh secrets
STRIPE_WEBHOOK_SECRET=

# Key used to sign login tokens (at least 32 characters). Leave blank and
# 1-setup.sh generates one and keeps reusing it. Changing it logs everyone out.
JWT_SECRET=

# Chat assistant (Claude API). Get a key at https://console.anthropic.com/
# Leave blank to deploy without it; the assistant then replies that it's unavailable.
ANTHROPIC_API_KEY=
# Model for the chat assistant. claude-haiku-5-5 is the cheapest option.
CLAUDE_MODEL=claude-opus-5-5
